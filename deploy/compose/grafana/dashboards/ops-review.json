    {
      "id": 18,
      "type": "table",
      "title": "Tier 0 availability, region x day (synthetic)",
      "description": "Red below 99.99, amber to 99.995, green above.",
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "testdata"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99.99
              },
              {
                "color": "green",
                "value": 99.995
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "D-.|Today"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "testdata"
          },
          "scenarioId": "csv_content",
          "csvContent": "region,D-6,D-5,D-4,D-3,D-2,D-1,Today\nus-east,99.999,99.998,99.997,99.999,99.996,99.999,99.998\nus-west,99.999,99.9995,99.999,99.985,99.992,99.999,99.999\neu-west,99.998,99.999,99.9,99.995,99.999,99.999,99.997\nap-south,99.996,99.992,99.999,99.999,99.97,99.998,99.999"

{
  "uid": "ts2-ops-review",
  "title": "TS2 Ops Review",
  "tags": [
    "ts2",
    "ops-review"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "region",
        "type": "custom",
        "query": "us-east,us-west,eu-west,ap-south",
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {
          "text": "us-east",
          "value": "us-east"
        }
      },
      {
        "name": "cell",
        "label": "cell",
        "type": "custom",
        "query": "cell-1,cell-2,cell-3",
        "multi": false,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service levels (live metrics)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "text",
      "title": "Reading this dashboard",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Source: `ts2_http_requests_total` and `ts2_http_request_duration_seconds` from FrontdoorService. A 5xx is bad, a 4xx is good. Targets are the illustrative numbers in [service levels](http://localhost:8000/engineering/service-levels/). The error budget uses the dashboard time range as its window, so set the range to 30d for the real view. Window: `$__range`."
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tier 0 availability (range)",
      "description": "Red below customer SLO 99.99%, amber up to internal SLO 99.995%, green above.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9998999999999999
              },
              {
                "color": "green",
                "value": 0.99995
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(ts2_http_requests_total{operation=~\"PutObject|GetObject|HeadObject|DeleteObject\",status_class=\"5xx\"}[$__range])) or vector(0)) / sum(increase(ts2_http_requests_total{operation=~\"PutObject|GetObject|HeadObject|DeleteObject\"}[$__range]))",
          "legendFormat": "Tier 0",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tier 0 availability (5 min windows)",
      "description": "5xx as bad. Lines: customer SLO 99.99%, internal SLO 99.995%.",
